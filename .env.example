# ── Database (local Docker Compose) ─────────────────────────
POSTGRES_USER=quiz
POSTGRES_PASSWORD=quiz_dev_only
POSTGRES_DB=quiz
DATABASE_URL="postgresql://quiz:quiz_dev_only@localhost:5432/quiz?schema=public"

# ── Backend ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
JWT_SECRET="replace-with-openssl-rand-hex-64"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-openssl-rand-hex-64"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGINS="http://localhost:5173"
TEACHER_CODE="replace-with-pre-seed-code"
# Directory for teacher-uploaded question images (created on demand, 5 MB cap)
UPLOAD_DIR="./uploads"
VIOLATION_WARN_AT=2
VIOLATION_SUBMIT_AT=3

# ── OAuth (Google) ──────────────────────────────────────────
OAUTH_GOOGLE_CLIENT_ID="replace-me"
OAUTH_GOOGLE_CLIENT_SECRET="replace-me"

# ── Frontend ────────────────────────────────────────────────
VITE_API_URL="http://localhost:3000"
